{
  "name": "game1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D browser game built with Babylon.js (WebGPU with WebGL2 fallback), shipped as a static site.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:update": "npm run build:e2e && playwright test --grep @visual --update-snapshots=all",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "qa": "npm run check && npm run test:e2e",
    "agent:check": "node scripts/agent-run.mjs check",
    "agent:qa": "node scripts/agent-run.mjs qa",
    "agent:unit": "node scripts/agent-run.mjs unit",
    "agent:e2e": "node scripts/agent-run.mjs e2e",
    "agent:visual": "node scripts/agent-run.mjs visual",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.1"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.37.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
